rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reads caller's role from userProfiles — used to gate teacher-only writes
    function myRole() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role;
    }
    function isTeacher() {
      return request.auth != null && myRole() == 'TEACHER';
    }

    // ── User Profiles — hər user yalnız öz datasına çata bilər ────────────────
    match /userProfiles/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Digər userlərin notification/received yazması (müəllim → şagird, valideyn → şagird)
    match /userProfiles/{userId}/notifications/{notifId} {
      allow write: if request.auth != null;
    }
    match /userProfiles/{userId}/received/{msgId} {
      allow write: if request.auth != null;
    }

    // ── Public Profiles ────────────────────────────────────────────────────────
    // Only owner, teachers with a permission, and linked parents can read.
    // Wildcard "all auth users" was removed — it exposed minors' names+emails.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        myRole() == 'TEACHER' ||
        myRole() == 'PARENT'
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Parental Consent Requests ──────────────────────────────────────────────
    // Written by the student (their own doc), read/updated by any authenticated
    // user whose email matches parentEmail (enforced app-side; Firestore can't
    // query by the caller's email without a Cloud Function).
    match /consentRequests/{studentUid} {
      allow create: if request.auth != null && request.auth.uid == studentUid;
      allow read:   if request.auth != null && (
        request.auth.uid == studentUid ||
        myRole() == 'PARENT'
      );
      allow update: if request.auth != null && myRole() == 'PARENT';
    }

    // ── Groups ─────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if isTeacher();
      allow update: if request.auth != null &&
        (resource == null || resource.data.teacherUid == request.auth.uid);
      allow delete: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid;
    }

    // ── Permissions ────────────────────────────────────────────────────────────
    match /permissions/{permId} {
      allow read: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid
      );
    }

    // ── Homeworks ──────────────────────────────────────────────────────────────
    match /homeworks/{hwId} {
      allow read: if request.auth != null;
      allow create: if isTeacher();
      allow update, delete: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid;
    }

    // ── Homework Attempts ──────────────────────────────────────────────────────
    match /homeworkAttempts/{attId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.studentUid == request.auth.uid;
    }

    // ── Sinaq Exams ────────────────────────────────────────────────────────────
    match /sinaqExams/{examId} {
      allow read: if request.auth != null;
      allow create: if isTeacher();
      allow update: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid;
    }

    // ── Sinaq Attempts ─────────────────────────────────────────────────────────
    match /sinaqAttempts/{attId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ── Parent Requests ────────────────────────────────────────────────────────
    match /parentRequests/{reqId} {
      allow read: if request.auth != null && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.childUid == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.childUid == request.auth.uid
      );
    }

    // ── Parent–Teacher Messages ────────────────────────────────────────────────
    match /parentTeacherMessages/{msgId} {
      allow read: if request.auth != null && (
        resource.data.parentUid == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid
      );
      allow create: if request.auth != null;
    }

    // ── Group Messages ─────────────────────────────────────────────────────────
    match /groupMessages/{msgId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }

    // ── Exams ──────────────────────────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow create: if isTeacher();
      allow update: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid;
    }

    // ── Interventions ──────────────────────────────────────────────────────────
    match /interventions/{id} {
      allow create: if isTeacher();
      allow read, update, delete: if request.auth != null &&
        resource.data.teacherUid == request.auth.uid;
    }

    // ── Weekly Reports ─────────────────────────────────────────────────────────
    match /weeklyReports/{reportId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        resource.data.parentUid == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        resource.data.parentUid == request.auth.uid
      );
    }

    // ── Live Session Watchers ──────────────────────────────────────────────────
    match /liveSessionWatchers/{sessionId} {
      allow read, write: if request.auth != null;
    }
  }
}
